# PixelCraft Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/pixelcraft?schema=public"

# NextAuth (for admin authentication - optional)
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (required for contact form delivery)
# Create a Resend API key and verify pixelscraft.online in Resend.
RESEND_API_KEY=""

# Analytics (optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
